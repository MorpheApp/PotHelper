<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_launcher_name">

        <activity
            android:name=".MainActivity"
            android:theme="@style/AppTheme"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The provider and the service below are the IPC surface that client
            apps bind to, so they must stay exported and cannot require a
            permission that those clients do not hold.

            The provider exposes no data of its own: query returns an empty
            cursor, insert, update and delete are no-ops, and call only resolves
            services that live in this package. A read or write permission would
            not protect it either, because ContentProvider.call is not covered by
            those permissions.
        -->
        <provider
            android:name=".chimera.ServiceProvider"
            android:authorities="app.morphe.pot.helper.chimera"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name=".potokens.PoTokenService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="app.morphe.pot.helper.potokens.service.START" />
            </intent-filter>
        </service>
    </application>
</manifest>
